{
  "name": "ai-property-search-backend",
  "version": "1.0.0",
  "description": "AI-powered property search backend with natural language processing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db": "node utils/dbTest.js",
    "test:atlas": "node utils/atlasConnectionTest.js",
    "validate:atlas": "node utils/validateAtlasUri.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
